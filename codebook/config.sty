% Listings style configuration
% Note: framesep=2pt + 0.4pt rule extends 2.4pt outside the text box.
% Setting aboveskip=3.5pt and belowskip=2.4pt reserves exact space for the frame
% plus ~1pt of breathing room so the border never overlaps text above or below it.
\lstset{
  language=cpp,
  basicstyle=\ttfamily\footnotesize\color{black},
  keywordstyle=[1]\color{keyword}\bfseries,
  keywordstyle=[2]\color{type}\bfseries,
  keywordstyle=[3]\color{stl}\bfseries,
  keywordstyle=[4]\color{function}\bfseries,
  commentstyle=\color{comment}\itshape,
  stringstyle=\color{string},
  backgroundcolor=\color{codebg},
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=8pt,
  xleftmargin=2em,
  framexleftmargin=2em,
  framesep=2pt,
  frame=single,
  rulecolor=\color{gray},
  keepspaces=true,
  columns=fullflexible,
  breaklines=true,
  aboveskip=3.5pt,
  belowskip=2.4pt,
  showstringspaces=false,
  literate={*}{{\color{operator}\char42}}1
             {-}{{\color{operator}\char45}}1
             {+}{{\color{operator}+}}1
             {=}{{\color{operator} = }}1
             {==}{{\color{operator}== }}1
             {!}{{\color{operator}!}}1
             {.}{{\color{operator}.}}1
             {<}{{\color{operator}<}}1
             {:}{{\color{operator}:}}1
             {>}{{\color{operator}>}}1
             {&}{{\color{operator}\&}}1
             {|}{{\color{operator}|}}1
             {\ }{{\copyablespace}}1
}

