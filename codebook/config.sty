% Usage: \code{Title}{folder/file.cpp}
\newcommand{\code}[2]{%
  \section{#1}%
  \lstinputlisting{../code_library/#2}%
}

\newlength{\cwdImgWidth}
\setlength{\cwdImgWidth}{0.1\linewidth}

% \codeWithDescription{Title}{filepath}[Description][Image][Usage]
\NewDocumentCommand{\codeWithDescription}{ m m o o o }{%
  \section{#1}%
  \IfValueT{#3}{%
    {\footnotesize\setlength{\baselineskip}{9.5pt}\emergencystretch=1em%
      % --- Description + optional image ---
      \IfValueTF{#4}{%
        \if\relax\detokenize{#4}\relax
          \noindent\textbf{Description:} #3\strut\par
        \else
          \noindent
          \begin{minipage}[t]{\dimexpr\linewidth-\cwdImgWidth-0.5em\relax}%
            \vspace{0pt}%
            \footnotesize\textbf{Description:} #3\strut%
          \end{minipage}%
          \hspace{0.3em}%
          \begin{minipage}[t]{\cwdImgWidth}%
            \vspace{0pt}%
            \includegraphics[width=\linewidth]{#4}%
          \end{minipage}%
          \par
        \fi
      }{%
        \noindent\textbf{Description:} #3\strut\par
      }%
      % --- Optional usage ---
      \IfValueT{#5}{%
        \vspace{1pt}%
        \noindent\textbf{Usage:} \texttt{\detokenize{#5}}\strut\par
      }%
    }%
    \vspace{1pt}%
  }%
  \lstinputlisting{../code_library/#2}%
}